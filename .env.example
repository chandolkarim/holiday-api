# 로컬 시험 서버(scripts/dev.mjs)에서 실제 공공데이터를 부를 때만 씁니다.
# 이 파일을 복사해 이름을 .env.local로 바꾸고, = 뒤에 일반 인증키(Decoding)를 붙여 넣습니다.
# .env.local은 .gitignore에 있어 저장소에 올라가지 않습니다.
DATA_GO_KR_KEY=

# 방명록(api/guestbook.js)을 로컬에서 실제 Supabase로 확인할 때만 씁니다. 값은 Supabase 대시보드 → Project Settings → API Keys.
# SUPABASE_SECRET_KEY는 서버 전용입니다. 화면(HTML)·저장소·채팅에 붙여 넣지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
